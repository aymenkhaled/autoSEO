DATABASE_URL=postgresql://autoseo:devpassword@localhost:5432/autoseo_dev
REDIS_URL=redis://localhost:6379/0

# Leave these blank for local JWT auth, or set real Supabase values if you use Supabase-backed browser auth.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=super-secret-jwt-token-for-local-dev-minimum-32-chars-long!!

FRONTEND_URL=http://127.0.0.1:5000
API_URL=http://127.0.0.1:8000
ENVIRONMENT=development
DEBUG=true

# Optional providers
ANTHROPIC_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=price_starter
STRIPE_PRO_PRICE_ID=price_pro
STRIPE_AGENCY_PRICE_ID=price_agency
RESEND_API_KEY=
SENTRY_DSN=
SCRAPFLY_API_KEY=

# Storage / encryption / GitHub app
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET=autoseo-storage
CLOUDFLARE_R2_ENDPOINT=
DOPPLER_MASTER_ENCRYPTION_KEY=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=
GITHUB_WEBHOOK_SECRET=

# Google OAuth / Google data sources
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/google/search-console/callback
GOOGLE_ANALYTICS_REDIRECT_URI=http://127.0.0.1:8000/api/v1/google/analytics/callback
GOOGLE_PAGESPEED_API_KEY=
GOOGLE_CRUX_API_KEY=

# Post-fix indexing
INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow
